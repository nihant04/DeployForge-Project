# DeployForge Portfolio Environment Configuration Example
# Copy this file to '.env' and fill in your details.

# =========================================================================
# DATABASE INTEGRATION OPTIONS (Production Persistent Storage)
# =========================================================================

# Option A: MongoDB Integration
# If provided, submissions will be stored directly inside this MongoDB cluster.
# Example: mongodb+srv://username:password@cluster.mongodb.net/deployforge
MONGODB_URI=

# Option B: Vercel KV (Serverless Redis REST API)
# Perfect for zero-config persistence. If you add "KV" integration in your Vercel Dashboard,
# Vercel automatically populates these two environment variables for you!
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Note: If BOTH MongoDB_URI and KV_REST_API are omitted, the application operates
# in Fallback Mode, writing to a local JSON file (src/data/contacts.json).
# (Note: Local JSON file storage is read-only/ephemeral in Vercel Serverless environment).

# =========================================================================
# SECURITY CONFIGURATION
# =========================================================================

# The passcode needed to view telemetry logs and inquiries on the '/admin' dashboard.
# Defaults to 'admin123' if left blank or omitted.
ADMIN_KEY=admin123
